# Content Studio configuration. Copy to .env and fill in the two API keys.
# Every process (api, worker, web, docker compose, prisma) reads this one file.
# Relative paths resolve from this folder (content-studio/).

# ── Infrastructure (docker compose) ───────────────────────────────────────────
POSTGRES_USER=studio
POSTGRES_PASSWORD=studio_local_password
POSTGRES_DB=content_studio
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://studio:studio_local_password@localhost:5432/content_studio?schema=public
REDIS_URL=redis://localhost:6379

# ── Shared by api + worker ────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true
QUEUE_NAME=generations
QUEUE_PREFIX=studio
PROMPTS_DIR=../prompts
PROMPT_VERSION=v1
PROMPT_CACHE_ENABLED=true
SHUTDOWN_TIMEOUT_MS=10000

# ── API (Fastify) ─────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=4000
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:3000
BODY_LIMIT_BYTES=16384
QUEUE_JOB_ATTEMPTS=1
QUEUE_BACKOFF_MS=5000
QUEUE_KEEP_COMPLETED=1000
QUEUE_KEEP_FAILED=5000
TOPIC_MAX_LENGTH=500
SEARCH_MAX_LENGTH=200
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
SSE_HEARTBEAT_MS=15000
SSE_RETRY_MS=3000
INSIGHTS_TREND_DAYS=30

# ── Worker (BullMQ + LangGraph pipeline) — keys stay server-side ──────────────
WORKER_CONCURRENCY=2
WORKER_LOCK_DURATION_MS=60000
WORKER_STALLED_INTERVAL_MS=30000
WORKER_MAX_STALLED_COUNT=1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-flash-latest
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=8192
# The judge reuses the agent settings unless you override them. Set JUDGE_MODEL
# (and optionally JUDGE_BASE_URL / JUDGE_API_KEY) for a truly independent judge.
JUDGE_ENABLED=true
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_TEMPERATURE=0.1
JUDGE_MAX_TOKENS=4096
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=2
TAVILY_API_KEY=
RESEARCH_SEARCH_DEPTH=advanced
RESEARCH_MAX_RESULTS=3
RESEARCH_TIMEOUT_MS=60000
MEMORY_TOP_K=3
MEMORY_MIN_OVERLAP=1
MEMORY_SNIPPET_CHARS=400
MEMORY_CANDIDATE_LIMIT=500
CONTENT_LOCALE=en

# ── Web (Next.js) ─────────────────────────────────────────────────────────────
PORT=3000
PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://127.0.0.1:4000
APP_TIME_ZONE=Asia/Kolkata
HISTORY_PAGE_SIZE=20
RECENT_RUNS_LIMIT=5

# ── One-off import of the Python CLI's memory (npm run db:import-history) ─────
LEGACY_HISTORY_FILE=../memory/posts_history.json
